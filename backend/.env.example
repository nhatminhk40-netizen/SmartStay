PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smartstay?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Gmail SMTP Configuration for OTP Email
# Tạo mật khẩu ứng dụng 16 ký tự tại: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_16_digit_app_password
