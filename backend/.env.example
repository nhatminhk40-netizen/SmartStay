PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smartstay?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Gmail SMTP Configuration for OTP & Pass Room Email
# Tạo mật khẩu ứng dụng 16 ký tự tại: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_16_digit_app_password

# Cấu hình Frontend URL để tạo link xác nhận chủ trọ /xac-nhan-pass/:token
FRONTEND_URL=http://localhost:5173

# (Tùy chọn) API email thay thế Gmail SMTP (Render Free khuyến nghị dùng Brevo / Resend):
BREVO_API_KEY=your_brevo_api_key
RESEND_API_KEY=your_resend_api_key
